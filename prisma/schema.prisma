generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ASSISTANT
}

enum LedgerReason {
  TOPUP
  GENERATION
  EDIT
  REFUND
  ADJUSTMENT
}

enum VersionStatus {
  READY
  DRAFT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ProjectOperation {
  EXPORT
  RESTORE
  WAKE
}

enum SandboxOutcome {
  RESUMED
  REBUILT
  FAILED
}

enum GithubExportStatus {
  QUEUED
  RECOVERING
  PREPARING
  PUSHING
  SUCCEEDED
  FAILED
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  projects      Project[]
  attachments   Attachment[]
  memoryEnabled Boolean      @default(true)
  notifyEmail   Boolean      @default(true)

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Project {
  id                 String            @id @default(cuid())
  slug               String            @unique
  name               String
  description        String?
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sandboxId          String?
  previewUrl         String?
  githubRepo         String?
  operationId        String?
  operationKind      ProjectOperation?
  operationStartedAt DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  messages           Message[]
  versions           Version[]
  githubExports      GithubExport[]

  @@index([userId, updatedAt])
}

model GithubExport {
  id            String             @id @default(cuid())
  projectId     String
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId        String
  versionId     String
  versionNumber Int
  name          String
  private       Boolean
  status        GithubExportStatus @default(QUEUED)
  attempt       Int                @default(1)
  runId         String?
  repository    String?
  repositoryUrl String?
  branch        String?
  baseCommit    String?
  commitSha     String?
  error         String?
  errorCode     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  completedAt   DateTime?

  @@index([projectId, createdAt])
  @@index([userId, status])
}

model Message {
  id              String       @id @default(cuid())
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role            Role
  content         String
  parts           Json?
  model           String?
  replyToId       String?
  replyTo         Message?     @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         Message[]    @relation("Replies")
  startedAt       DateTime?
  stopRequestedAt DateTime?
  attachments     Attachment[]
  createdAt       DateTime     @default(now())

  @@index([projectId, createdAt])
  @@index([replyToId])
}

model Attachment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId   String?
  message     Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  key         String   @unique
  name        String
  contentType String
  size        Int
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([messageId])
}

model Version {
  id         String        @id @default(cuid())
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number     Int?
  status     VersionStatus @default(READY)
  runId      String?
  title      String
  files      Json
  creditCost Int
  createdAt  DateTime      @default(now())

  @@unique([projectId, number])
  @@index([projectId, status])
}

model GuardEvent {
  id         String   @id @default(cuid())
  userId     String
  projectId  String?
  runId      String?
  stage      String
  verdict    String
  categories String[]
  textHash   String
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
}

model CreditLedger {
  id        String       @id @default(cuid())
  userId    String
  delta     Int
  reason    LedgerReason
  projectId String?
  paymentId String?      @unique
  meta      Json?
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  provider    String
  providerRef String        @unique
  amountCents Int
  currency    String        @default("usd")
  status      PaymentStatus
  createdAt   DateTime      @default(now())

  @@index([userId, createdAt])
}

model ThrottleWindow {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model SandboxEvent {
  id        String         @id @default(cuid())
  projectId String?
  outcome   SandboxOutcome
  createdAt DateTime       @default(now())

  @@index([createdAt])
}

model MemoryUsage {
  month        String    @id
  writeChars   Int       @default(0)
  searches     Int       @default(0)
  profiles     Int       @default(0)
  estimatedUsd Float     @default(0)
  alertedAt    DateTime?
  updatedAt    DateTime  @updatedAt
}

model EmailUsage {
  day       String    @id
  sent      Int       @default(0)
  alertedAt DateTime?
  updatedAt DateTime  @updatedAt
}

