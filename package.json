{
  "name": "agentic-website-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun run db:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "icons:generate": "node scripts/generate-file-icons.mjs",
    "logos:generate": "node scripts/generate-model-logos.mjs",
    "clean": "rm -rf .next out build coverage test-results playwright-report blob-report tsconfig.tsbuildinfo next-env.d.ts",
    "db:generate": "bunx --bun prisma generate",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:deploy": "bunx --bun prisma migrate deploy",
    "db:seed": "bunx --bun prisma db seed",
    "db:studio": "bunx --bun prisma studio",
    "inngest:dev": "npm exec --yes --ignore-scripts=false -- inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "sandbox:build": "bun sandbox-templates/nextjs/build.ts",
    "agent:smoke": "bun --conditions=react-server scripts/agent-smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/s3-presigned-post": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@base-ui/react": "^1.9.0",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@secretlint/core": "13.1.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@sindresorhus/slugify": "^4.0.1",
    "@streamdown/code": "^2.0.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-query": "^5.107.1",
    "@trpc/client": "^11.28.0",
    "@trpc/server": "^11.28.0",
    "@trpc/tanstack-react-query": "^11.28.0",
    "ai": "^7.0.168",
    "ansi-to-react": "^6.2.6",
    "better-auth": "^1.7",
    "class-variance-authority": "^0.7.1",
    "client-only": "^0.0.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "dotenv": "^18.0.10",
    "e2b": "^2.63.0",
    "files-sdk": "^3.1.2",
    "inngest": "^4.26.2",
    "lucide-react": "^1.71.0",
    "motion": "^14.12.0",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "nuqs": "^2.10.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.21.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "streamdown": "^2.7.1",
    "superjson": "^2.2.6",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@iconify-json/material-icon-theme": "^1.2.77",
    "@iconify/utils": "^3.1.7",
    "@lobehub/icons-static-svg": "^1.102.0",
    "@neon/config": "^1.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/dom-speech-recognition": "^0.0.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
