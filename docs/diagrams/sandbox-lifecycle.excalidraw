    {
      "id": "t_12",
      "type": "text",
      "x": 0,
      "y": 715,
      "width": 843.1171875,
      "height": 60,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aG",
      "roundness": null,
      "seed": 1445472967,
      "version": 2,
      "versionNonce": 80711721,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794691507001,
      "link": null,
      "locked": false,
      "text": "monitor-sandboxes (every 30 min) alerts when ≥ 3 attempts in the window and ≥ 50 % were REBUILT or FAILED.\nSandboxes are tagged { app: \"vibe\", database: <hash of DB host> } so a dev database can never delete production's sandboxes.\nMid-run loss: the tool step recreates the sandbox from the DRAFT checkpoint, replays this run's file writes and retries the call once.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "monitor-sandboxes (every 30 min) alerts when ≥ 3 attempts in the window and ≥ 50 % were REBUILT or FAILED.\nSandboxes are tagged { app: \"vibe\", database: <hash of DB host> } so a dev database can never delete production's sandboxes.\nMid-run loss: the tool step recreates the sandbox from the DRAFT checkpoint, replays this run's file writes and retries the call once.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Ykk8_-zr7Ji239zb1fA6p",
