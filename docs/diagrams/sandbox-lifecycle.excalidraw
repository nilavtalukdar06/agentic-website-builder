      "link": null,
      "locked": false,
      "text": "autoResume = false:\npreview traffic alone never\nwakes (or bills) a sandbox.\nThe workspace calls\nsandbox.wake on open and\nshows \"Waking up the preview…\"",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "autoResume = false:\npreview traffic alone never\nwakes (or bills) a sandbox.\nThe workspace calls\nsandbox.wake on open and\nshows \"Waking up the preview…\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
