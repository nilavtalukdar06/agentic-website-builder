    {
      "id": "t_134",
      "type": "text",
      "x": 30,
      "y": 1100,
      "width": 301.19384765625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1h",
      "roundness": null,
      "seed": 444255401,
      "version": 2,
      "versionNonce": 1615218953,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794691503966,
      "link": null,
      "locked": false,
      "text": "Better Auth owns these four tables plus RateLimit\n(its database-backed limiter, production only).\nOAuth tokens are encrypted at rest; repo scope is\nadded at first export with linkSocial().",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Better Auth owns these four tables plus RateLimit\n(its database-backed limiter, production only).\nOAuth tokens are encrypted at rest; repo scope is\nadded at first export with linkSocial().",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t_135",
      "type": "text",
      "x": 30,
      "y": 1640,
      "width": 236.6162109375,
      "height": 56.25,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1i",
      "roundness": null,
      "seed": 2028236391,
      "version": 2,
      "versionNonce": 1692755975,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1794691503966,
      "link": null,
      "locked": false,
      "text": "CreditLedger.paymentId is unique, so a\nre-delivered Stripe webhook can never\ngrant the same payment twice.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CreditLedger.paymentId is unique, so a\nre-delivered Stripe webhook can never\ngrant the same payment twice.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t_136",
