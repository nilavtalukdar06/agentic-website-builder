      "link": null,
      "locked": false,
      "text": "A duplicate delivery hits the same providerRef and paymentId → both upserts are no-ops.\nasync_payment_succeeded is handled the same way for delayed payment methods.",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "note_38",
      "originalText": "A duplicate delivery hits the same providerRef and paymentId → both upserts are no-ops.\nasync_payment_succeeded is handled the same way for delayed payment methods.",
