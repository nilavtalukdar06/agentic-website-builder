      "link": null,
      "locked": false,
      "text": "Left: synchronous request handlers (tRPC, route handlers). Right: durable Inngest functions. They never call each other —\nthey meet only in the data stores in the middle, including the event queue.",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Left: synchronous request handlers (tRPC, route handlers). Right: durable Inngest functions. They never call each other —\nthey meet only in the data stores in the middle, including the event queue.",
      "autoResize": true,
      "lineHeight": 1.25
    },
