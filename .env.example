# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon)
# Pooled connection string, used by Prisma Client through the Neon adapter
DATABASE_URL=
# Direct (non-pooled) connection string, used by prisma.config.ts for migrations
DIRECT_URL=

# Auth (Better Auth + GitHub OAuth app)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# GitHub OAuth app callback: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Credits granted once on first sign-in (0 disables)
WELCOME_CREDITS=5

# AI (Vercel AI Gateway: every model, live prices, exact per-call cost)
# Create a key in the Vercel dashboard under AI Gateway > API keys
AI_GATEWAY_API_KEY=
# Default model for new prompts; must be in the curated list (src/lib/ai/models.ts)
AI_DEFAULT_MODEL=anthropic/claude-sonnet-5.5

# Policy classifier for input and output guardrails (Phase 5), called through AI Gateway
AI_GUARD_MODEL=openai/gpt-oss-safeguard-20b

# Credits: credits = ceil(model cost in USD x CREDITS_PER_USD x CREDIT_MARKUP), cost reported by AI Gateway
CREDITS_PER_USD=100
# 1 = charge model cost only; 1.5 = 50% margin
CREDIT_MARKUP=1

# Sandbox (E2B). Build the template with `bun run sandbox:build`, then paste the printed id
E2B_API_KEY=
E2B_TEMPLATE_ID=

# Image attachments (Neon Object Storage, bucket "attachments" declared in neon.ts)
# `neon link` then `neon deploy` provisions the bucket and writes these to .env.local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Inngest. Local: INNGEST_DEV=1 and `bun run inngest:dev`; use a full URL for a custom dev-server port. Production: unset INNGEST_DEV, set both keys
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Stripe Checkout (test mode until ready for live payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Operational alerts (optional): a Slack- or Discord-compatible incoming webhook. Without it alerts are only written to the server log
ALERT_WEBHOOK_URL=

# Arcjet (Shield WAF, bot detection, rate limiting, prompt-injection Guard). Get a site key with `arcjet sites get-key`
ARCJET_KEY=
# Set to "development" for local dev/e2e: without it Arcjet can't fingerprint loopback requests and every decision fails open
ARCJET_ENV=development

# Browser checks (Browserbase). The agent opens each build in a cloud browser, checks desktop and phone,
# clicks the planned interactions and streams a live view to the workspace. Leave empty to skip the checks.
BROWSERBASE_API_KEY=
# on | off
AGENT_BROWSER_QA=on

# Memory (Supermemory). Remembers each user's preferences across projects and each project's corrections,
# from the user's own words only. Leave the key empty to turn memory off.
SUPERMEMORY_API_KEY=
# on | off
AGENT_MEMORY=on
# Monthly budget guard for the free plan ($5 of credits): writes stop at 80%, reads at 100%
MEMORY_MONTHLY_USD=4.5

# Email notifications (Resend). Tells users when a build finishes, fails or runs out of credits, and when
# a GitHub export finishes or fails. Leave the key empty to turn emails off.
RESEND_API_KEY=
# The free onboarding sender below can only deliver to the email address of your Resend account.
# Verify a domain at resend.com/domains and change this to send to every user, for example: Vibe <notify@yourdomain.com>
EMAIL_FROM=Vibe <onboarding@resend.dev>
# on | off
EMAIL_NOTIFICATIONS=on
# Free plan allows 100 emails a day: finished-build emails stop at 80% of this, failure emails at 100%
EMAIL_DAILY_LIMIT=100

