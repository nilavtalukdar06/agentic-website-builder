# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon)
# Pooled connection string, used by Prisma Client through the Neon adapter
DATABASE_URL=
# Direct (non-pooled) connection string, used by prisma.config.ts for migrations
DIRECT_URL=

# Dev routes
# Set to true to serve /dev/* pages in a production build (e.g. Playwright). Always available in development.
DEV_ROUTES_ENABLED=false
