# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon)
# Pooled connection string, used by Prisma Client through the Neon adapter
DATABASE_URL=
# Direct (non-pooled) connection string, used by prisma.config.ts for migrations
DIRECT_URL=

# Auth (Better Auth + GitHub OAuth app)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# GitHub OAuth app callback: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Credits granted once on first sign-in (0 disables)
WELCOME_CREDITS=5
