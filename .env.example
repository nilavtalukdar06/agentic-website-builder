# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon)
# Pooled connection string, used by Prisma Client through the Neon adapter
DATABASE_URL=
# Direct (non-pooled) connection string, used by prisma.config.ts for migrations
DIRECT_URL=

# Auth (Better Auth + GitHub OAuth app)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# GitHub OAuth app callback: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Credits granted once on first sign-in (0 disables)
WELCOME_CREDITS=5

# AI (Vercel AI Gateway: every model, live prices, exact per-call cost)
# Create a key in the Vercel dashboard under AI Gateway > API keys
AI_GATEWAY_API_KEY=
# Default model for new prompts; must be in the curated list (src/lib/ai/models.ts)
AI_DEFAULT_MODEL=anthropic/claude-sonnet-5.5

# Policy classifier for input and output guardrails (Phase 5), called through AI Gateway
AI_GUARD_MODEL=openai/gpt-oss-safeguard-20b

# Credits: credits = ceil(model cost in USD x CREDITS_PER_USD x CREDIT_MARKUP), cost reported by AI Gateway
CREDITS_PER_USD=100
# 1 = charge model cost only; 1.5 = 50% margin
CREDIT_MARKUP=1

# Sandbox (E2B). Build the template with `bun run sandbox:build`, then paste the printed id
E2B_API_KEY=
E2B_TEMPLATE_ID=

# Image attachments (Neon Object Storage, bucket "attachments" declared in neon.ts)
# `neon link` then `neon deploy` provisions the bucket and writes these to .env.local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Inngest. Local: INNGEST_DEV=1 and `bun run inngest:dev`. Production: unset INNGEST_DEV, set both keys
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
